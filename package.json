    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.11.6",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^7.1.7",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.1.3"
