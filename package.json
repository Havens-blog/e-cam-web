  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gz": "vite build && node scripts/generate-gz.mjs",
    "build:check": "vue-tsc -b && vite build",
