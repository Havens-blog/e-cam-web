    "test:watch": "vitest",
    "preview": "vite preview",
    "ci:gzip-budget": "node scripts/gzip-budget.mjs dist",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "@haven/ui": "link:../haven-ui",
