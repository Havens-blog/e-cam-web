    "axios": "^1.6.8",
    "dayjs": "^1.11.19",
    "echarts": "^5.5.0",
    "element-plus": "^2.11.7",
    "fflate": "^0.8.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "xlsx": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
